# -------------------------------------------------------------
# EMPRESARIAL SAAS — CONFIGURACIÓN DE ENTORNO
# -------------------------------------------------------------

# Supabase PostgreSQL (Transaction Pooler - Puerto 6543)
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URI="postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones DDL (Puerto 5432)
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Payload Secret (Mínimo 32 caracteres criptográficos)
PAYLOAD_SECRET="empresarial-saas-secret-key-at-least-32-chars-long"

# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Certificado SSL Supabase (Opcional en desarrollo, recomendado en producción)
SUPABASE_CA_CERT=""

# S3 Object Storage (Cloudflare R2 / AWS S3 / Supabase Storage)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# SMTP Email Adapter (Resend / SendGrid / Amazon SES / Postmark)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_ADDRESS="soporte@empresarial-saas.com"
SMTP_FROM_NAME="Empresarial SaaS"
