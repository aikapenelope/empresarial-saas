# -------------------------------------------------------------
# EMPRESARIAL SAAS — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Supabase PostgreSQL (Transaction Pooler - Port 6543)
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URI=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexión directa para migraciones DDL (Puerto 5432)
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Payload Secret (Mínimo 32 caracteres)
PAYLOAD_SECRET=your-secure-payload-secret-key-at-least-32-chars

# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Certificado SSL Supabase (Opcional en desarrollo local, recomendado en producción)
SUPABASE_CA_CERT=
