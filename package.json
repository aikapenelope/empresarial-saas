{
  "name": "empresarial-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation IS_PAYLOAD_MIGRATION=true payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation IS_PAYLOAD_MIGRATION=true payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation IS_PAYLOAD_MIGRATION=true payload migrate:status",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage.enabled"

  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-import-export": "3.88.0",
    "@payloadcms/plugin-multi-tenant": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@aws-sdk/lib-storage": "3.1126.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
